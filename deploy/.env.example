# ============================================================
# mediaGet 运行环境变量（示例模板）
#

# ---- 解析站点 ----
# 功能开关：仅值为 "true" 时放开视频解析入口（/api/config 读取；未配置默认关闭）
VIDEO_PARSE_ENABLED=true
# 蜜罐页引导 URL 前缀（默认站点）
# NEXT_PUBLIC_SITE_URL=https://get.hotier.cc.cd

# ---- 平台 Cookie（可选；敏感值只在服务端 Node runtime 读取）----
# 抖音（可选，仅增强；UA 轮询已硬编码）
# DOUYIN_COOKIE=
# 哔哩哔哩（强烈建议，穿透数据中心/海外出口 -412/-352 WAF；含失效自检告警）
# BILIBILI_COOKIE=
# 哔哩哔哩 UA（已写入 wrangler.toml [vars]，Docker 部署如需覆盖在此配置）
# BILIBILI_USER_AGENT=
# 小红书（可选）
# XHS_COOKIE=
# Instagram（强烈建议）
# IG_COOKIE=
# Instagram 超时（ms，默认 20000）
# IG_TIMEOUT_MS=20000
# QQ音乐 source+id（可选，vkey 试听接口）
# QQMUSIC_COOKIE=
# X/Twitter fixer 服务集（可选，覆盖默认 fixer 集）
# TWITTER_FIXER_SERVICES=

# ---- YouTube ----
# 公共 Piped 候选（默认内置 3 个；可自托管覆盖）
# YOUTUBE_PIPED_HOSTS=
# 公共 Invidious 候选（默认不启用，需显式配置或自托管）
# YOUTUBE_INVIDIOUS_HOSTS=
# Data API v3 密钥（仅优先元数据，无直链）
# YOUTUBE_API_KEY=
# YOUTUBE_API_TIMEOUT_MS=5000
# YOUTUBE_SOURCE_TIMEOUT_MS=6000

# ---- 音乐聚合上游（/api/music，GD 契约）----
# 公共实例对数据中心出口会被 CF 人机校验拦，线上建议自建可直连实例
# MUSIC_API_BASE=https://your-gd-api.example.com/api.php
# MUSIC_API_BASES=https://a.example.com/api.php, https://b.example.com/api.php

# ---- 平台能力矩阵（搜索引擎 / 播放引擎；见 API.md §12）----
# 取值：留空 / "default" → 内置默认（两维均 6 平台全开）；"all" → 全开；JSON 对象 → 部分覆盖
# MUSIC_PLATFORM_SEARCH=
# MUSIC_PLATFORM_PLAY=
# 黑名单（逗号分隔平台键，最终闸门，优先级最高）
# MUSIC_PLATFORM_SEARCH_DISABLED=tencent
# MUSIC_PLATFORM_PLAY_DISABLED=tencent,kugou,migu
# 整体下线便捷变量（等效写入上面两个黑名单）
# MUSIC_PLATFORM_OFF=tencent,kugou,migu
# 内置播放引擎总开关（"off" = 运维终闸 / 设置页「部署锁定」；搜索等数据通道不受影响）
# MUSIC_BUILTIN_PLAY=off

# ---- 解析行为统计 + 音乐设置存储（Turso/libsql；未配置静默禁用）----
TURSO_DB_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=your_token
# Turso 单次请求超时（ms，默认 8000，夹在 500~60000；跨境链路慢时放宽）
# TURSO_HTTP_TIMEOUT_MS=8000
STATS_API_KEY=your_stats_key

# ---- 音乐设置面板（/music/settings，登录鉴权；见 API.md §12.6）----
# 设置页登录密钥（未配置则设置页只读、无法登录，caps editable=false）
# SETTINGS_API_KEY=your_settings_key
# 会话令牌签名密钥（可选，缺省回落 SETTINGS_API_KEY；轮换即让全部会话失效）
# SETTINGS_SESSION_SECRET=your_session_secret

# ---- PO Token 提供方（自建 bgutil-ytdlp-pot-provider 容器，宿主机端口）----
# 应用容器经 host.docker.internal 访问宿主机端口；未配置则 PO Token 功能自动关闭
# POT_BASE_URL=http://host.docker.internal:PORT

# ---- 本地开发 / 真机测试（仅本地用，Docker 部署不需要）----
# RUN_LIVE_PARSE=1
# LIVE_URL_*（各平台真实分享链接，模板见 tests/live/urls.example.env）
